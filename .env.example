# 复制为 .env 后按需修改；docker compose 会自动读取同目录的 .env。

# 镜像：默认使用 GitHub Actions 发布的最新版本，可固定为某个版本，如 ghcr.io/duegin/serpent:0.2.0
SERPENT_IMAGE=ghcr.io/duegin/serpent:latest

# 宿主机端口
SERPENT_PORT=8008

# 对外访问地址（反向代理后填域名）
PUBLIC_URL=http://localhost:8008

# 用户 JWT 签名密钥；留空则首次启动自动生成并保存在数据卷中
JWT_SECRET=

# 后台天梯匹配器：1 开启，0 关闭（手动 queue 仍可开赛）
LADDER_AUTO=1

# 模拟 worker 线程数；留空按 CPU 自动选择（最多 4）
RUNNER_WORKERS=

# Python 解释器并发：每个 runner worker 最多同时运行的解释器数与预热数。
# 每个解释器约 200MB 内存；最坏占用约 RUNNER_WORKERS × (PYTHON_MAX_HOSTS + PYTHON_WARM_HOSTS) × 200MB。
PYTHON_MAX_HOSTS=4
PYTHON_WARM_HOSTS=1

# 仅本地从源码构建时使用：基础镜像、npm 源与 Debian 软件源镜像
# 国内网络示例：NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim、DEBIAN_MIRROR=mirrors.aliyun.com
NODE_IMAGE=node:22-bookworm-slim
NPM_REGISTRY=https://registry.npmmirror.com
DEBIAN_MIRROR=
